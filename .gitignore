# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Data (never commit; data/fish_oil is a symlink to the alignment repo)
# Anchored to the repo root: docs/data/ is the project site's data and is tracked.
/data/
*.cdf
*.mzML
*.mzXML
*.npz
*.h5

# Outputs: no caches or binaries in git. Text reports and captions are tracked.
checkpoints/
*.pt
*.npy
*.pkl
/results/*
!/results/*.txt
/figs/**/*.png
/figs/**/*.pdf
logs/
*.log

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Test artefacts
.coverage
.pytest_cache/
junit.xml
